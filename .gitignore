# =============================================================================
# Aegis Data Recovery - Git Ignore Rules
# =============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.pyd

# C / Rust compiled extension binaries
*.so
*.dylib
*.dll
*.pdb
*.exp
*.lib

# Rust / Cargo artifacts
target/

# Distribution & packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
*.whl

# Virtual Environments
venv/
.venv/
env/
.env/
ENV/
env.bak/
venv.bak/
myenv/
myenv*/

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/

# Type Checking
.mypy_cache/
.dmypy.json
dmypy.json

# IDEs & Text Editors
.vscode/
.idea/
*.swp
*.swo
*~
.project
.pydevproject
.settings/

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# Data Recovery Staging & Carved Artifacts (Protect User Privacy)
Recovered_Data/
Aegis_Recovered_Data/
Output/
.aegis_staging/
*.dd
*.img
*.raw
*.bin
*.dmp
*.iso
*.vmdk
*.vhd
*.vhdx

# Application Logs
*.log
logs/
Logs/

# Installer & Build Tools
InstallerOutput/
AegisRecovery.spec
setup.iss
